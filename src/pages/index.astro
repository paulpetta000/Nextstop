---
// La home (grafica A «Rivista», bozzetto design/home/a.html; specifiche/home-e-identita.md).
// Dall'alto: apertura con la foto e «Quanto tempo hai?», come funziona, itinerari pronti, dove mangiare, perché fidarti,
// le prossime città. Ogni numero viene dai dati, ricalcolato a ogni build: niente è scritto a mano.
import Base from '../layouts/Base.astro';
import Testo from '../components/Testo.astro';
import Immagine from '../components/Immagine.astro';
import Campata from '../components/Campata.astro';
import { getTesti, type Blocco } from '../lib/testi';
import { riempi } from '../lib/regole.mjs';
import { LICENZE } from '../lib/foto';
import { cittaNapoli, prontiNapoli, LINEE } from '../lib/itinerari/napoli';
import { CITTA, linkPronto } from '../config/menu';
import { SITO } from '../config/sito';
import { CUCINE } from '../lib/locali';
import { dataLunga } from '../lib/formato';
import { ora } from '../lib/itinerari/date';
import { getCollection, getEntry } from 'astro:content';

const T = await getTesti('home');
const C = await cittaNapoli();
const napoli = CITTA[0];
const fonti = await getCollection('fonti');

const tappe = C.tappe.filter(t => !t.categoria && t.tipo === 'citta');
const gite = C.tappe.filter(t => t.tipo === 'gita');
const locali = C.tappe.filter(t => t.categoria === 'mangiare');
const nome = (id: string) => C.tappe.find(t => t.id === id)!;

// Un blocco dei testi con i numeri veri al posto di {tappe}, {locali}…
const con = (b: string, valori: Record<string, string | number>): Blocco => { const x = T.b(b); return { ...x, html: riempi(`home#${b}`, x.html, valori) }; };

// Gli itinerari pronti con la durata (non quello delle regate): tappe e minuti a piedi dal calcolo della build
const pronti = (await prontiNapoli()).filter(p => p.durata && !p.evento).map(p => {
  const voci = p.giorni.flatMap(g => g.voci);
  return {
    ...p,
    numero: p.durata!.split(' ')[0],
    nTappe: voci.filter(v => v.tipo === 'tappa').length,
    minPiedi: voci.reduce((s, v) => s + (v.tipo === 'tratto' && !v.mezzi.length ? v.min : 0), 0)
  };
});
if (pronti.some(p => !p.foto)) throw new Error('Ogni itinerario pronto della home vuole una «foto» in src/data/itinerari-pronti.yaml');

// L'esempio di «Guarda quanto ci metti»: un tratto vero del primo giorno di «Due giorni a Napoli»
const esempio = (() => {
  const voci = pronti.find(p => p.id === 'due-giorni')?.giorni[0].voci ?? pronti[0].giorni[0].voci;
  const i = voci.findIndex((v, k) => v.tipo === 'tappa' && voci[k + 1]?.tipo === 'tratto' && voci[k + 2]?.tipo === 'tappa' && k > 0);
  const [a, t, b] = [voci[i], voci[i + 1], voci[i + 2]];
  if (a?.tipo !== 'tappa' || t?.tipo !== 'tratto' || b?.tipo !== 'tappa') throw new Error('Home: manca un esempio di tratto tra due tappe');
  const come = t.mezzi.length ? t.mezzi.map(m => LINEE[m] ?? m).join(' e ') : 'a piedi';
  const metri = t.metri >= 1000 ? `${(t.metri / 1000).toFixed(1).replace('.', ',')} km` : `${Math.round(t.metri / 10) * 10} m`;
  return { da: { ora: ora(a.inizio), nome: nome(a.id).breve }, a: { ora: ora(b.inizio), nome: nome(b.id).breve }, tratto: `${t.min} min ${come}`, metri };
})();

// Dove mangiare: le famiglie di locali, con quanti ce ne sono (stessi nomi dei filtri della pagina)
const FAMIGLIE = ['pizza', 'napoletana', 'pesce', 'strada', 'dolci'];
const famiglie = FAMIGLIE.map(k => ({ k, nome: CUCINE[k], n: locali.filter(l => l.cucina?.includes(k)).length })).filter(f => f.n > 0);

// Le foto della pagina e i loro crediti (la foto grande li ha anche sopra)
const FOTO_APERTURA = 'tp-spaccanapoli', FOTO_MANGIARE = 'tp-borgo-marinari';
const credito = async (id: string) => {
  const f = await getEntry('foto', id);
  if (!f) throw new Error(`Foto "${id}" non trovata`);
  return { id, alt: f.data.alt, autore: f.data.autore, autoreUrl: f.data.autoreUrl, licenza: f.data.licenza, licUrl: LICENZE[f.data.licenza], fonte: f.data.fonte, didascalia: f.data.didascalia };
};
const crediti = await Promise.all([FOTO_APERTURA, ...pronti.map(p => p.foto!), FOTO_MANGIARE].map(credito));
const cr0 = crediti[0];
---
<Base title="Itinerari in città" description={`Itinerari a Napoli pronti o fatti da te, con i tempi veri a piedi, in metro, in funicolare e in autobus: ${tappe.length} tappe in città, ${gite.length} gite e ${locali.length} locali dove mangiare.`} home>
  <div class="home">
    <section class="apertura" aria-labelledby="h-home">
      <span class="apertura__sfondo"><Immagine id={FOTO_APERTURA} prima qualita={40} class="apertura__foto" widths={[480, 750, 1000]} sizes="100vw" posizione="50% 38%" /></span>
      <div class="dentro apertura__dentro">
        <h1 id="h-home" class="titolone"><span>{napoli.nome},</span> <span>con i tempi veri.</span></h1>
        <Testo b={T.b('apertura')} class="apertura__lead" />
        <div class="tempo">
          <h2 class="tempo__titolo" id="h-tempo">Quanto tempo hai?</h2>
          <!-- una fascia unica: il numero grande e, sotto, la parola («½ giornata», «2 giorni»); il nome intero per chi non vede -->
          <ul class="tempo__scelte" aria-labelledby="h-tempo">
            {pronti.map(p => (
              <li>
                <a class="scelta" href={linkPronto(napoli, p.id)} aria-label={`${p.durata}: ${p.nome}`}>
                  <span class="scelta__n" aria-hidden="true">{p.numero}</span>
                  <span class="scelta__u" aria-hidden="true">{p.durata.split(' ').slice(1).join(' ')}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="tempo__tuo" href={`${napoli.itinerari}#compositore`}>Oppure componi il tuo itinerario<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        </div>
        <p class="apertura__credito">Foto: {cr0.autoreUrl ? <a href={cr0.autoreUrl} rel="noopener">{cr0.autore}</a> : cr0.autore}, {cr0.licUrl ? <a href={cr0.licUrl} rel="noopener license">{cr0.licenza}</a> : cr0.licenza}</p>
      </div>
    </section>

    <section class="sezione dentro come" aria-labelledby="h-come">
      <div class="come__intro">
        <h2 id="h-come" class="serif sezione__titolo">Come funziona</h2>
        <Testo b={T.b('come')} />
      </div>
      <div class="passi-box">
        <svg class="passi__linea" viewBox="0 0 40 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M20 2 C 36 22, 4 38, 20 52 S 36 82, 20 98" vector-effect="non-scaling-stroke" /></svg>
        <ol class="passi">
          <li class="passo"><h3 class="titolone">Scegli le tappe</h3><Testo b={con('passo-tappe', { tappe: tappe.length, gite: gite.length })} /></li>
          <li class="passo"><h3 class="titolone">Guarda quanto ci metti</h3><Testo b={T.b('passo-tempi')} />
            <p class="esempio">
              <span class="esempio__ora">{esempio.da.ora}</span><span>{esempio.da.nome}</span>
              <span class="esempio__tratto"><b>{esempio.tratto}</b>, {esempio.metri}</span>
              <span class="esempio__ora">{esempio.a.ora}</span><span>{esempio.a.nome}</span>
            </p>
          </li>
          <li class="passo"><h3 class="titolone">Leggi gli avvisi</h3><Testo b={T.b('passo-avvisi')} /></li>
        </ol>
      </div>
    </section>

    <!-- il portico nasce da una nebbia color pietra: niente stacco netto tra la carta e la pietra -->
    <section class="sezione sezione--pronti" aria-labelledby="h-pronti">
      <div class="dentro">
      <div class="pronti__testa">
        <h2 id="h-pronti" class="serif sezione__titolo">Itinerari pronti</h2>
        <a class="btn" href={`${napoli.itinerari}#compositore`}>Componi il tuo</a>
      </div>
      <!-- il portico: un'arcata per itinerario, una accanto all'altra; sul telefono scorre di lato -->
      <div class="portico-scena">
      <ul class="portico">
        {pronti.map((p, i) => (
          <li>
            <a class="scheda" href={linkPronto(napoli, p.id)}>
              <Campata id={`pronto-${p.id}`} foto={p.foto!} indice={i} pos={+(i - (pronti.length - 1) / 2).toFixed(2)} widths={[320, 480, 640]} sizes="(min-width: 900px) 15rem, min(62vw, 17rem)" />
              <span class="scheda__testo">
                <span class="scheda__nome serif">{p.nome}</span>
                <span class="scheda__dati"><span><b>{p.nTappe}</b> tappe</span> <span><b>{p.minPiedi}</b> min a piedi</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      </div>
      </div>
    </section>

    <section class="su-notte sezione mangiare-banda" aria-labelledby="h-mangiare">
      <div class="dentro mangiare">
        <!-- il rombo a tre piani: l'ombra, il contorno sfalsato più indietro, la foto davanti; il titolo si appoggia sulla punta -->
        <div class="rombo">
          <svg class="rombo__ombra" viewBox="-30 -30 160 160" aria-hidden="true" focusable="false"><defs><filter id="rombo-sfuma" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="9" /></filter></defs><polygon points="50,0 100,50 50,100 0,50" fill="#000" fill-opacity=".55" filter="url(#rombo-sfuma)" /></svg>
          <span class="rombo__eco" aria-hidden="true"></span>
          <span class="rombo__foto"><Immagine id={FOTO_MANGIARE} class="rombo__img" widths={[400, 600, 800]} sizes="(min-width: 900px) 24rem, 82vw" /></span>
        </div>
        <div class="mangiare__testi">
          <h2 id="h-mangiare" class="serif sezione__titolo">Dove mangiare</h2>
          <Testo b={con('mangiare', { locali: locali.length })} class="mangiare__testo" />
          <ul class="famiglie">
            {famiglie.map(f => <li><a href={`${napoli.mangiare}?cucina=${f.k}`}>{f.nome}<span>{f.n} locali</span></a></li>)}
          </ul>
          <a class="btn btn--chiaro mangiare__tutti" href={napoli.mangiare}>Tutti i locali</a>
        </div>
      </div>
    </section>

    <section class="sezione dentro" aria-labelledby="h-fidarti">
      <h2 id="h-fidarti" class="serif sezione__titolo">Perché fidarti</h2>
      <div class="foglietti">
        <Testo b={con('fidarti-fonti', { fonti: fonti.length })} class="foglietto" />
        <Testo b={con('fidarti-data', { data: dataLunga(SITO.aggiornato).replace(' ', ' ') /* «4 ottobre» non va a capo */ })} class="foglietto" />
        <Testo b={T.b('fidarti-link')} class="foglietto" />
        <Testo b={T.b('fidarti-rete')} class="foglietto" />
      </div>
    </section>

    <div class="dentro">
      <div class="citta-dopo">
        <Testo b={T.b('prossime')} />
        <span class="citta-dopo__linea" aria-hidden="true"></span>
        <span class="citta-dopo__fermata" aria-hidden="true"></span>
      </div>
      <p class="crediti">
        Foto di questa pagina, da Wikimedia Commons:{' '}
        {crediti.map((c, i) => (
          <>{i > 0 && '; '}{c.didascalia.replace(/\.$/, '')} di {c.autoreUrl ? <a href={c.autoreUrl} rel="noopener">{c.autore}</a> : c.autore} ({c.licUrl ? <a href={c.licUrl} rel="noopener license">{c.licenza}</a> : c.licenza}, <a href={c.fonte} rel="noopener">origine</a>)</>
        ))}.
      </p>
    </div>
  </div>
</Base>

<style>
  /* ---------- base della pagina ---------- */
  .home { color: var(--inchiostro); }
  /* via gli stili di prima di global.css (margini, elenchi, colore dei link), con il peso più basso possibile */
  :global(.home) :where(h1, h2, h3, p, ul, ol) { margin: 0; }
  :global(.home) :where(ul, ol) { padding: 0; list-style: none; }
  :global(.home) :where(li + li) { margin-top: 0; }
  :global(.home) :where(a) { color: inherit; }
  .home :global(.testo) { margin: 0; }
  .home :global(.testo p) { margin: 0; max-width: 62ch; text-wrap: pretty; }
  .dentro { width: 100%; max-width: var(--largo); margin-inline: auto; padding-inline: var(--lato); }
  .sezione { padding-block: clamp(3.5rem, 10vw, 6.5rem); }
  .titolone { font-family: var(--f-sans); font-weight: 800; font-stretch: 70%; letter-spacing: -.015em; line-height: .92; text-wrap: balance; }
  .serif { font-family: var(--f-serif); font-weight: 600; font-optical-sizing: auto; letter-spacing: -.01em; line-height: 1.05; text-wrap: balance; }
  .sezione__titolo { font-size: clamp(2rem, 7vw, 3.25rem); }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 48px; padding: .75rem 1.375rem; border-radius: 999px; border: 1.5px solid var(--inchiostro); background: transparent; color: var(--inchiostro); font: 600 1rem/1.2 var(--f-sans); text-decoration: none; cursor: pointer;
    transition: transform var(--m100) var(--entra), background-color var(--m150) var(--entra), color var(--m150) var(--entra); }
  .btn:active { transform: scale(.97); }
  @media (hover: hover) { .btn:hover { background: var(--inchiostro); color: var(--carta); } }
  .btn--chiaro { border-color: var(--su-notte); color: var(--su-notte); }
  @media (hover: hover) { .btn--chiaro:hover { background: var(--su-notte); color: var(--notte); } }

  /* ---------- apertura: foto a tutto schermo, la promessa, «Quanto tempo hai?» ---------- */
  .apertura { position: relative; isolation: isolate; display: flex; align-items: flex-end; min-height: min(100svh, 52rem); overflow: hidden; background: #1B2232; color: #FFFFFF; --anello: #F0BE3E; }
  .apertura__sfondo { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .apertura :global(.apertura__foto) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .apertura::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(8, 12, 22, .5) 0%, rgba(8, 12, 22, .12) 18%, rgba(8, 12, 22, .5) 40%, rgba(8, 12, 22, .86) 70%, rgba(8, 12, 22, .95) 100%); }
  .apertura__dentro { display: grid; gap: 1.25rem; padding-block: calc(var(--head-h) + 3rem) 1.5rem; }
  .apertura h1 { font-size: clamp(3.1rem, 15vw, 7.5rem); max-width: 11ch; text-shadow: 0 2px 24px rgba(0, 0, 0, .35); }
  .apertura h1 span { display: block; }
  .apertura :global(.apertura__lead p) { max-width: 34rem; font-size: 1.0625rem; line-height: 1.5; color: rgba(255, 255, 255, .9); }
  .apertura__credito { font-size: .75rem; color: rgba(255, 255, 255, .72); }
  /* «Quanto tempo hai?»: una fascia unica, come un biglietto, con il numero grande in Bodoni e la parola sotto */
  .tempo { display: grid; gap: .85rem; padding-top: .5rem; }
  .tempo__titolo { font: italic 500 1.5rem/1.1 var(--f-serif); letter-spacing: 0; }
  .tempo__scelte { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); max-width: 30rem; border-radius: 20px; overflow: clip;
    background: rgba(14, 18, 30, .36); -webkit-backdrop-filter: blur(14px) saturate(1.25); backdrop-filter: blur(14px) saturate(1.25);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .3), inset 0 1px 0 rgba(255, 255, 255, .22), 0 22px 44px -20px rgba(0, 0, 0, .7); }
  .tempo__scelte li { display: grid; }
  .tempo__scelte li + li { border-left: 1px solid rgba(255, 255, 255, .2); }
  .scelta { position: relative; display: grid; justify-items: center; align-content: center; gap: .35rem; min-height: 5.75rem; padding: .7rem .25rem 1rem; color: #FFFFFF; text-decoration: none;
    transition: background-color var(--m150) var(--entra), color var(--m150) var(--entra); }
  .scelta__n { font-family: var(--f-serif); font-weight: 600; font-optical-sizing: auto; font-size: 2.75rem; line-height: .9; }
  .scelta__u { font-size: .8125rem; font-weight: 500; line-height: 1; color: rgba(255, 255, 255, .8); transition: color var(--m150) var(--entra); }
  /* il punto color tufo che compare sotto, come una fermata */
  .scelta::after { content: ''; position: absolute; left: 50%; bottom: .45rem; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: var(--tufo); opacity: 0; translate: 0 4px;
    transition: opacity var(--m150) var(--entra), translate var(--m200) var(--entra); }
  @media (hover: hover) { .scelta:hover { background: rgba(255, 255, 255, .1); } .scelta:hover::after { opacity: 1; translate: 0 0; } }
  .scelta:active { background: #F3F1EC; color: #12182A; }
  .scelta:active .scelta__u { color: #3A3F4B; }
  .scelta:focus-visible { outline-offset: -4px; border-radius: 16px; }
  .tempo__tuo { justify-self: start; display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; color: #FFFFFF; font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-decoration-color: rgba(255, 255, 255, .5); text-underline-offset: 6px; }
  .tempo__tuo svg { width: 20px; height: 20px; flex: none; transition: translate var(--m200) var(--entra); }
  @media (hover: hover) { .tempo__tuo:hover svg { translate: 4px 0; } .tempo__tuo:hover { text-decoration-color: #FFFFFF; } }
  @media (prefers-reduced-motion: no-preference) {
    .apertura :global(.apertura__foto) { animation: respira var(--m300) var(--entra) both; }
    .apertura h1 span, .apertura :global(.apertura__lead), .tempo { animation: sali var(--m300) var(--entra) both; }
    .apertura h1 span:nth-child(2) { animation-delay: 80ms; }
    .apertura :global(.apertura__lead) { animation-delay: 160ms; }
    .tempo { animation-delay: 220ms; }
  }
  /* scorrendo, la foto scende più piano della pagina e si avvicina un poco; le parole salgono e sfumano: due piani, uno dietro l'altro */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .apertura__sfondo { animation: apertura-lontana linear both; animation-timeline: scroll(root); animation-range: 0 100svh; }
      .apertura__dentro { animation: apertura-vicina linear both; animation-timeline: scroll(root); animation-range: 0 90svh; }
    }
  }
  @keyframes apertura-lontana { to { translate: 0 32%; scale: 1.08; } }
  @keyframes apertura-vicina { to { translate: 0 -14%; opacity: .2; } }
  @keyframes respira { from { transform: scale(1.04); } }
  @keyframes sali { from { transform: translateY(10px); opacity: .01; } }

  /* ---------- come funziona: tre passi lungo un percorso che si disegna ---------- */
  .come { display: grid; gap: 2.5rem; }
  @media (min-width: 900px) { .come { grid-template-columns: 1fr 1.3fr; align-items: start; gap: 4rem; } }
  .come__intro { display: grid; gap: .75rem; max-width: 36rem; }
  .passi-box { position: relative; }
  .passi { position: relative; display: grid; gap: 2.25rem; padding-left: 3.25rem; counter-reset: passo; }
  .passi__linea { position: absolute; left: 0; top: .2rem; width: 2.5rem; height: calc(100% - .4rem); overflow: visible; }
  .passi__linea path { fill: none; stroke: var(--tufo); stroke-width: 3; stroke-linecap: round; }
  .passo { position: relative; display: grid; gap: .35rem; counter-increment: passo; }
  .passo::before { content: counter(passo); position: absolute; left: -3.25rem; top: -.1rem; width: 2.5rem; height: 2.5rem; display: grid; place-items: center; border-radius: 50%; background: var(--carta); border: 2px solid var(--inchiostro); font-weight: 800; font-stretch: 75%; font-size: 1.05rem; line-height: 1; }
  .passo h3 { font-size: 1.625rem; }
  .esempio { justify-self: start; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: .15rem .75rem; max-width: 26rem; margin-top: .6rem; padding: .85rem 1rem; border-radius: 14px; background: var(--pietra); font-size: .95rem; font-variant-numeric: tabular-nums; }
  .esempio__ora { font-weight: 700; }
  .esempio__tratto { grid-column: 2; padding: .1rem 0 .1rem .65rem; margin-left: -.1rem; border-left: 3px dotted var(--tufo); color: var(--inchiostro-2); font-size: .875rem; }
  .esempio__tratto b { color: var(--inchiostro); font-weight: 600; }
  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .passi-box { view-timeline: --passi; }
      .passi__linea path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: traccia linear both; animation-timeline: --passi; animation-range: entry 20% cover 62%; }
    }
  }
  @keyframes traccia { to { stroke-dashoffset: 0; } }

  /* ---------- itinerari pronti: il portico di piperno ---------- */
  .sezione--pronti { padding-top: 0; --nebbia: color-mix(in srgb, #6C675F 17%, var(--carta)); }
  /* il portico si disegna quando ci arrivi vicino: all'apertura il browser pensa solo alla foto in alto (non sulla banda di «Dove mangiare»: ritaglierebbe il rombo che esce sopra) */
  .sezione--pronti { content-visibility: auto; contain-intrinsic-size: auto 900px; }
  .pronti__testa { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  /* la nebbia color pietra dietro il portico: dalla carta alla pietra senza uno stacco */
  .portico-scena { position: relative; isolation: isolate; padding-top: 2.5rem; }
  .portico-scena::before { content: ''; position: absolute; z-index: -1; inset: -1rem calc(var(--lato) * -1) -2rem; pointer-events: none;
