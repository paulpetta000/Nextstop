---
// Itinerari a Napoli: il compositore (specifiche/compositore.md), sotto «Da sapere» e le fonti; senza JavaScript gli itinerari pronti
// e le gite. Lo script della pagina è in src/scripts/itinerari/compositore/.
import Base from '../../../layouts/Base.astro';
import Testo from '../../../components/Testo.astro';
import FontiPagina from '../../../components/FontiPagina.astro';
import { getLocali } from '../../../lib/locali';
import { getTesti } from '../../../lib/testi';
import { tutteLeFonti } from '../../../lib/fatti';
import { getTappe } from '../../../lib/tappe';
import { cittaNapoli, impacchetta, prontiNapoli, REGATE } from '../../../lib/itinerari/napoli';
import { durata, ora } from '../../../lib/itinerari/date';
import '../../../styles/itinerari.css';
import '../../../styles/compositore.css';
import { datiUI } from '../../../lib/itinerari/ui';

const T = await getTesti('itinerari');
const TT = await getTesti('tappe');
const TL = await getTesti('locali');
const locali = await getLocali();
const tappe = await getTappe();
const C = await cittaNapoli();
const pronti = await prontiNapoli();
const fonti = await tutteLeFonti();
const pacco = impacchetta(C);

const gite = C.tappe.filter(t => t.tipo === 'gita');
const nomeDi = (id: string) => (id === REGATE.id ? REGATE.nome : C.tappe.find(t => t.id === id)!.nome);
// Schede mostrate così come sono (orari, prezzi, viaggi): anche le loro fonti vanno in fondo alla pagina
const schedeMostrate = [...tappe.flatMap(t => [...t.schede.values()]), ...locali.flatMap(l => [...l.schede.values()])];
const { ui } = await datiUI(C, tappe, locali);
const json = JSON.stringify(pacco).replace(/</g, '\\u003c');
---
<Base soloMenu title="Itinerari a Napoli: mezza giornata, 1, 2 e 3 giorni" description="Componi il tuo itinerario a Napoli: 51 tappe in città e 9 gite, con i tempi a piedi e con metro, funicolari e autobus, la mappa e gli avvisi. Itinerari pronti per mezza giornata, 1, 2 e 3 giorni e per un giorno di regata. Senza account, anche offline.">
  <script is:inline>
    // Un itinerario ricevuto con un link: lo prendo e tolgo il «#…» dall'indirizzo prima di tutto il resto,
    // così non finisce nelle statistiche né nella cronologia delle pagine viste.
    try { if (/[#&]g=/.test(location.hash)) { window.itinerarioRicevuto = location.hash; history.replaceState(null, '', location.pathname + location.search); } } catch (e) {}
    // Un locale da aggiungere, dalla pagina «Dove mangiare» (?aggiungi=…): stessa cosa, prima delle statistiche
    try { if (/[?&]aggiungi=/.test(location.search)) { window.daAggiungere = location.search; history.replaceState(null, '', location.pathname + location.hash); } } catch (e) {}
    // Un itinerario pronto scelto dalla home o dal menu (?pronto=…#pronto-…): lo carica il compositore. Tolgo anche il «#pronto-…»,
    // che serve solo senza JavaScript (porta alla scheda dell'itinerario, più in basso)
    try { var p = /[?&]pronto=([a-z0-9-]+)/.exec(location.search); if (p) { window.prontoRichiesto = p[1]; history.replaceState(null, '', location.pathname); } } catch (e) {}
    // Chi ha già itinerari sul telefono (o arriva con un link o un pronto) non vede la prima schermata: arriva subito il suo
    document.documentElement.classList.add('cmp-js');
    try { if (localStorage.getItem('itinerari-v1') || window.itinerarioRicevuto || window.prontoRichiesto) document.documentElement.classList.add('cmp-ha'); } catch (e) {}
  </script>
  <div class="it-pagina">

    <div class="cmp" id="compositore">
      <noscript>
        <div class="cmp-senza-js">
          <p>Per comporre un itinerario serve JavaScript, che in questo browser è spento. Qui sotto trovi gli itinerari pronti, con tutti gli orari, e le gite; per mangiare c'è <a href="/napoli/dove-mangiare/">Dove mangiare</a>.</p>
          <button class="tondo" type="button" popovertarget="menu" aria-label="Apri il menu">Menu</button>
        </div>
        <!-- Solo senza JavaScript: gli itinerari pronti con gli orari e le gite (gli indirizzi #pronto-… di home e menu portano qui).
             Con JavaScript il browser non legge questo blocco: i pronti stanno nel compositore (giorno vuoto e «Nuovo itinerario»). -->
        <div class="cmp-senza-js__elenco">
          <h2>Itinerari pronti</h2>
          <p>Gli orari sono quelli di un giorno feriale, partendo alle 9:30.</p>
          {pronti.map(p => (
            <section class="cmp-senza-js__pronto" id={`pronto-${p.id}`} aria-labelledby={`pronto-${p.id}-h`}>
              <h3 id={`pronto-${p.id}-h`}>{p.nome}</h3>
              <Testo b={T.b(`pronto-${p.id}`)} />
              {p.evento && <Testo b={T.b('regate')} />}
              {p.giorni.map((g, k) => (
                <div>
                  {p.giorni.length > 1 && <h4>Giorno {k + 1}</h4>}
                  <ol>
                    {g.voci.filter(v => v.tipo === 'tappa').map(v => v.tipo === 'tappa' && <li><span class="num">{ora(v.inizio)}</span> {nomeDi(v.id)}</li>)}
                  </ol>
                  <p>Dalle {ora(g.inizio)} alle {ora(g.fine)}, con {durata(g.spostamenti)} di spostamenti.</p>
                </div>
              ))}
            </section>
          ))}
          <h2>Gite di un giorno</h2>
          <Testo b={T.b('gite')} />
          <ul>{gite.map(g => <li><b>{g.nome}</b>: da {g.partenza}, {g.durata > 240 ? 'giornata intera' : 'mezza giornata'}</li>)}</ul>
        </div>
      </noscript>
      <h1 class="vh">Itinerari a Napoli</h1>
      <!-- La prima schermata, già nell'HTML: si vede subito, poi il compositore la sostituisce (per chi ha già itinerari sul telefono resta invisibile) -->
      <div id="app" class="cmp-app"><div class="cmp-primo"><p class="cmp-primo__t">Itinerari a Napoli</p><p class="cmp-primo__p">Componi le tue giornate: scegli le tappe, vedi quanto ci metti a piedi e con i mezzi, controlla tutto sulla mappa. Gli itinerari restano sul telefono e si mandano con un link.</p></div></div>
      <dialog id="foglio" aria-labelledby="f-titolo"></dialog>
      <dialog id="scheda" aria-labelledby="sch-t"></dialog>
      <dialog id="calendario" aria-labelledby="cal-t"></dialog>
      <div id="toast" role="status" aria-live="polite"></div>
      <p id="annuncio" class="vh" aria-live="polite"></p>
      <p id="aiuto-maniglia" hidden>Trascina con il dito o con il mouse. Con la tastiera usa le frecce su e giù.</p>
      <!-- Le schede delle tappe, dei locali e delle gite e i dati della ricerca sono in /napoli/itinerari/schede/ (schede.astro): arrivano dopo il primo disegno -->
      <script type="application/json" id="it-dati" set:html={json} />
      <script type="application/json" id="it-pronti" set:html={JSON.stringify(pronti.map(p => ({ id: p.id, nome: p.nome, durata: p.durata, evento: p.evento, giorni: p.it.giorni }))).replace(/</g, '\\u003c')} />
      <script type="application/json" id="it-ui" set:html={JSON.stringify(ui).replace(/</g, '\\u003c')} />
    </div>

    <section class="it-sezione" id="da-sapere" aria-labelledby="sapere-h">
      <div class="it-wrap it-testi">
        <h2 id="sapere-h">Da sapere</h2>
        <h3>Come calcoliamo i tempi</h3>
        <Testo b={T.b('tempi')} />
        <h3>Orari e prezzi</h3>
        <Testo b={T.b('orari')} />
        <h3>Dove restano i tuoi itinerari</h3>
        <Testo b={T.b('salvare')} />
      </div>
    </section>

    <FontiPagina testi={[T, TT, TL]} fatti={schedeMostrate} extra={[fonti.get('osm')!]} tappe={tappe} perimetro="Qui trovi le fonti delle tappe, dei locali e degli spostamenti disponibili in questa pagina, anche quando non sono nel viaggio che hai composto." />
  </div>
</Base>

<script>
  import '../../../scripts/itinerari/compositore/avvio.js';
</script>
