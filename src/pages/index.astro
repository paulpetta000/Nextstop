---
import Base from '../layouts/Base.astro';
import Immagine from '../components/Immagine.astro';
import Giornata from '../components/home/Giornata.astro';
import {cittaNapoli,prontiNapoli} from '../lib/itinerari/napoli';
import {calcolaGiorno} from '../lib/itinerari/calcolo';
import {ora} from '../lib/itinerari/date';
import type {Risultato} from '../lib/itinerari/tipi';
import {CITTA,linkPronto} from '../config/menu';
import {getCollection,getEntry} from 'astro:content';
import {dataLunga} from '../lib/formato';
import '../styles/home-o4.css';
const C=await cittaNapoli();
const pronti=(await prontiNapoli()).filter(p=>p.durata&&!p.evento);
const fonti=await getCollection('fonti');
const fatto=await getEntry('fatti','tp-sansevero-orari');
const fonte=await getEntry(fatto!.data.fonti[0]);
if(!fonte)throw new Error('Fonte Sansevero assente');
const nome=(id:string)=>C.tappe.find(t=>t.id===id)!.breve;
const piedi=(g:Risultato)=>g.voci.reduce((s,v)=>s+(v.tipo==='tratto'&&!v.mezzi.length?v.min:0),0);
const durata=(m:number)=>m>=60?Math.floor(m/60)+' h'+(m%60?' '+m%60+' min':''):m+' min';
const approssima=(m:number)=>durata(Math.round(m/5)*5);
const tempoTotale=(giorni:Risultato[])=>{const min=giorni.map(g=>g.visite+g.spostamenti);return 'Circa '+(min.length===1?approssima(min[0]):approssima(Math.min(...min))+'–'+approssima(Math.max(...min))+' al giorno');};
const titoli=['Il centro storico, a piedi','Dal Vomero al Plebiscito','Due giorni tra città e mare','Più tempo per Napoli'];
const testi=['Cappella Sansevero, Santa Chiara, Spaccanapoli e via dei Tribunali. Quattro tappe per entrare nel centro storico.','Castel Sant’Elmo e San Martino, poi la Pedamentina e il centro storico. Piazza del Plebiscito chiude il percorso.','Il centro storico il primo giorno. Il secondo scende dal Vomero e arriva a Monte Echia e Borgo Marinari.','Il viaggio continua con Capodimonte, le Catacombe, il MADRE e Napoli Sotterranea.'];
const brevi=['Sansevero → Santa Chiara → Spaccanapoli','Vomero → Pedamentina → Centro storico → Plebiscito','Centro storico · Vomero · Monte Echia · Borgo Marinari','Centro storico · Vomero · Capodimonte · Sanità'];
const fotoPiani=['tp-santa-chiara','tp-san-martino','via-partenope','vista-monte-echia'];
const didascalie=['La basilica di Santa Chiara','Il golfo da Castel Sant’Elmo','Castel dell’Ovo dal lungomare','Il golfo da Monte Echia'];
// Esempio dichiarato: stesso motore del compositore, nessun viaggio salvato letto o modificato.
const esempio={...pronti.find(p=>p.id==='un-giorno')!.it,data:'2026-10-15'};
const base=calcolaGiorno(C,esempio,0);
const senza=calcolaGiorno(C,{...esempio,giorni:esempio.giorni.map(g=>({...g,tappe:g.tappe.filter(id=>id!=='san-martino')}))},0);
const versioni=[{key:'base',risultato:base},{key:'senza',risultato:senza}];
---
<Base title="Napoli: itinerari pronti e giornate da comporre" description="Scopri Napoli con tappe già in ordine e tempi indicativi. Scegli da mezza giornata a tre giorni o componi il tuo itinerario." orizzonte>
<section class="o-opening">
<div class="o-scene"><Immagine id="tp-san-martino" class="hero-image" widths={[384,640,960,1400]} sizes="100vw" prima={true} qualita={55} />
<div class="o-shade"></div></div>
<div class="o-words wrap">
<h1 id="h-home">Napoli.<br>Dalla vista<br>al viaggio.</h1>
<p>Scopri Napoli con tappe già in ordine e tempi indicativi per organizzare la giornata. Parti da un percorso e adattalo a te.</p><a class="action " href="#itinerari">Scegli un itinerario<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M4 12h15m-6-6 6 6-6 6"/></svg></a><a class="hero-secondary" href="/napoli/itinerari/#compositore">Oppure componilo da zero</a></div>
<p class="o-caption">Il golfo da Castel Sant’Elmo</p></section>
<section class="choice sheet wrap" id="itinerari">
 <div class="choice-heading">
<h2 id="h-tempo">Quanto tempo hai<br />per Napoli?</h2>
<p>Da mezza giornata a tre giorni. Scegli il tuo percorso.</p></div>
 <nav class="duration-tabs" aria-label="Scegli il tempo del viaggio">{pronti.map((p,i)=><a href={'#viaggio-'+i} data-plan={i} aria-controls={'viaggio-'+i}>{p.durata}</a>)}</nav>
 <div class="plan-results" id="h-pronti">{pronti.map((p,i)=><article id={'viaggio-'+i} class="plan-result" data-plan-panel={i}>
  <div class="plan-identity plan-copy">
<p class="plan-duration">{p.durata}</p>
<h3>{titoli[i]}</h3>
<p class="plan-total">{tempoTotale(p.giorni)}</p>
<p class="fineprint">Pause escluse · {p.it.giorni.flatMap(g=>g.tappe).length} tappe</p>
<p>{testi[i]}</p>
   <p class="route-advice">{p.it.giorni.some(g=>g.tappe.includes('sansevero'))&&'Cappella Sansevero: prenotazione obbligatoria. '}{p.it.giorni.some(g=>g.tappe.includes('pedamentina'))&&'Pedamentina: discesa con molti gradini.'}</p>
   <a class="action" href={linkPronto(CITTA[0],p.id)}>Apri questo itinerario <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>
   <div class="plan-more">
<p class="route-brief"><span>Percorso in breve</span>{brevi[i]}</p>
    <details class="plan-times"><summary>{p.giorni.length>1?'Tempi giorno per giorno':'Come sono divisi i tempi'}</summary><dl>{p.giorni.map((g,n)=>
<div><dt>{p.giorni.length>1?'Giorno '+(n+1):'Questo percorso'}</dt><dd>{durata(g.visite)} di visite + {durata(piedi(g))} a piedi. Circa {approssima(g.visite+g.spostamenti)} complessive.</dd></div>)}</dl></details>
    <details class="plan-stops"><summary>Leggi tutte le tappe</summary><ol>{p.it.giorni.map((g,n)=>
<li class="route-day">{p.giorni.length>1&&<strong>Giorno {n+1}</strong>}<ol>{g.tappe.map(id=>
<li>{nome(id)}</li>)}</ol></li>)}</ol></details>
   </div>
  </div>
  <figure class="plan-picture"><Immagine id={fotoPiani[i]} widths={[384,640,960]} sizes="(min-width:900px) 500px, calc(100vw - 96px)" qualita={55}/><figcaption>{didascalie[i]}</figcaption></figure>
 </article>)}</div>
 <a class="text-link" href="/napoli/itinerari/#compositore">Hai già le tue tappe? Componi il tuo itinerario <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>
</section>
<section class="example wrap" id="giornata">
<div class="example-story">
<h2 id="h-come">La giornata prende<br>la tua forma.</h2>
<p>Dal Vomero al centro storico, scegli dove fermarti. Prova a togliere San Martino: vedrai cambiare il programma.</p>
<div class="example-compose"><a class="action quiet" href="/napoli/itinerari/#compositore">Componi la tua giornata<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>
<p class="fineprint">Scegli la tua data, le tappe e il tempo delle visite.</p></div></div>
<div class="day-program">
<h3>Dal Vomero al Plebiscito</h3>
<p class="example-date">Esempio: <time datetime="2026-10-15">giovedì 15 ottobre 2026</time>, partenza alle 9:30.</p>
<div class="day-control" hidden><label><input type="checkbox" data-include-museum checked aria-describedby="day-hint"><span>Includi la visita a San Martino</span></label>
<p id="day-hint" data-day-hint>Togli la visita per vedere come cambiano gli orari.</p></div>
<p class="day-live-result" role="status" aria-live="polite" aria-atomic="true"><span data-day-count>{base.n} tappe</span><span data-day-walk>{piedi(base)} min a piedi</span><span>Fine indicativa <strong data-day-end>{ora(base.fine)}</strong></span></p>{versioni.map(v=><Giornata risultato={v.risultato} citta={C} variante={v.key} nascosta={v.key==='senza'} />)}</div></section>
<section class="trust wrap" id="fidarti">
<div>
<h2 id="h-fidarti">Perché fidarti<br>di noi.</h2>
<p>Per organizzare Napoli, le informazioni devono essere controllabili. Nella guida puoi risalire alla fonte e alla data della verifica.</p>
<ul class="trust-reasons">
<li><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="m5 12 4 4L19 6"/></svg><span><strong>Fonti da consultare.</strong> Per gli orari di Sansevero, per esempio, trovi il sito del museo.</span></li>
<li><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="m5 12 4 4L19 6"/></svg><span><strong>La data è visibile.</strong> Sai quando è stata controllata la fonte.</span></li>
<li><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="m5 12 4 4L19 6"/></svg><span><strong>Tempi spiegati.</strong> Visite e camminate sono distinti; le pause restano da aggiungere.</span></li></ul><a class="action quiet" href="/fonti/">Leggi le nostre fonti<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>
<p class="fineprint trust-affiliation">I collegamenti non sono link di affiliazione.</p></div><article class="source-proof">
<h3>Cappella Sansevero</h3>
<p>Un esempio delle fonti della guida.</p><dl>
<div><dt>Informazione</dt><dd>Orari della visita</dd></div>
<div><dt>Fonte</dt><dd>{fonte.data.editore}</dd></div>
<div><dt>Controllata</dt><dd><time datetime={fonte.data.controllato}>{dataLunga(fonte.data.controllato)}</time></dd></div></dl><a class="text-link" href={fonte.data.url} target="_blank" rel="noopener">Apri la fonte <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>
<p class="fineprint">{fonti.length} fonti consultabili nella guida.</p></article></section>
<section class="practical wrap">
<figure class="practical-photo"><Immagine id="via-partenope" class="" widths={[384,640,960,1400]} sizes="(min-width:900px) 500px, calc(100vw - 80px)" prima={false} qualita={55} /><figcaption>Castel dell’Ovo dal lungomare</figcaption></figure>
<div>
<h2 id="h-mangiare">Il viaggio continua,<br>anche a tavola.</h2>
<p>Il lungomare, una piazza, una pausa. Esplora i {C.tappe.filter(t=>t.categoria==='mangiare').length} locali della guida e scegli dove fermarti.</p><a class="action quiet" href="/napoli/dove-mangiare/">Esplora dove mangiare<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></div></section>
<section class="closing wrap">
<h2>Hai trovato il tuo ritmo?</h2><a class="action " href="#itinerari">Scegli il tuo itinerario<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></section>
<script>import "../scripts/home-o4";</script>
</Base>