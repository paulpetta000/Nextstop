---
// Piè di pagina (DESIGN.md §5 e §7): banda blu notte con il marchio nella versione scura, le città e le pagine sulla trasparenza.
import Marchio from './Marchio.astro';
import { SITO } from '../config/sito';
import { CITTA, TRASPARENZA } from '../config/menu';
import { dataLunga } from '../lib/formato';
---
<footer class="piede">
  <div class="piede__dentro">
    <div class="piede__testa">
      <a class="piede__marchio" href="/"><Marchio dove="scuro" descr /></a>
      <p class="piede__nota">
        Sito indipendente di itinerari. Orari, prezzi e tempi vengono dalle fonti indicate in ogni pagina, con la data del controllo:
        prima di partire controlla sempre sui siti dei luoghi.
      </p>
    </div>
    <div class="piede__colonne">
      {CITTA.map(c => (
        <nav aria-labelledby={`piede-${c.id}`}>
          <h2 class="piede__titolo" id={`piede-${c.id}`}>{c.nome}</h2>
          <ul>
            <li><a href={c.itinerari}>Itinerari e compositore</a></li>
            <li><a href={c.mangiare}>Dove mangiare</a></li>
          </ul>
        </nav>
      ))}
      <nav aria-labelledby="piede-trasparenza">
        <h2 class="piede__titolo" id="piede-trasparenza">Trasparenza</h2>
        <ul>
          {TRASPARENZA.map(t => <li><a href={t.href}>{t.label}</a></li>)}
        </ul>
      </nav>
    </div>
    <div class="piede__fondo">
      <span>Controllo generale delle informazioni: {dataLunga(SITO.aggiornato)}</span>
      <span>Mappe: © i contributori di <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a></span>
    </div>
  </div>
</footer>

<style>
  .piede { margin-top: clamp(3rem, 8vw, 5rem); background: var(--notte); color: var(--su-notte); --anello: #F0BE3E; padding-block: clamp(2.5rem, 7vw, 4rem) calc(1.75rem + env(safe-area-inset-bottom, 0px)); font-size: .95rem; }
  .piede__dentro { width: 100%; max-width: var(--largo); margin-inline: auto; padding-inline: var(--lato); }
  .piede__testa { display: grid; gap: 1.25rem; padding-bottom: 2rem; border-bottom: 1px solid rgba(255, 255, 255, .14); }
  .piede__marchio { justify-self: start; display: inline-flex; min-height: 48px; align-items: center; color: inherit; text-decoration: none; border-radius: 8px; }
  .piede__marchio :global(.firma) { font-size: 1.75rem; }
  .piede__nota { margin: 0; max-width: 60ch; color: var(--su-notte-2); }
  .piede__colonne { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1.75rem; padding-block: 2rem; }
  .piede__titolo { margin: 0 0 .5rem; font: italic 500 1.25rem/1.1 var(--f-serif); letter-spacing: 0; color: var(--su-notte); }
  .piede ul { list-style: none; margin: 0; padding: 0; }
  .piede li { margin: 0; }
  .piede__colonne a { display: inline-flex; align-items: center; min-height: 44px; color: var(--su-notte); text-decoration: none; }
  @media (hover: hover) { .piede__colonne a:hover { text-decoration: underline; text-underline-offset: 4px; } }
  .piede__fondo { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255, 255, 255, .14); font-size: .8125rem; color: var(--su-notte-2); }
  .piede__fondo a { color: inherit; }
  @media (min-width: 760px) { .piede__testa { grid-template-columns: auto 1fr; align-items: center; gap: 3rem; } }
</style>
