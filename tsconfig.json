{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "checkJs": false
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "astro.config.mjs",
    "integrations/**/*.mjs"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "design",
    "docs",
    "ricerca",
    "test"
  ],
  "typeAcquisition": {
    "enable": false
  }
}
