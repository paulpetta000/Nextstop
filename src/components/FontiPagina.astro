---
import type { Fatto, Fonte } from '../lib/fatti';
import type { TestiPagina } from '../lib/testi';
import type { CollectionEntry } from 'astro:content';
import { tutteLeFonti } from '../lib/fatti';
import { fontiPerPagina } from '../lib/fonti-nextstop.mjs';
import { registroFonti, ordinaFonti, slugFonte } from '../lib/fonti-registro.mjs';
import Documento from './fonti/Documento.astro';
import '../styles/fonti-pannello.css';
interface Props { fatti?: Iterable<Fatto>; extra?: Fonte[]; testi?: TestiPagina | TestiPagina[]; cautela?: boolean; tappe?: CollectionEntry<'tappe'>[]; perimetro?: string; id?: string }
const { fatti=[], extra=[], cautela=false, tappe=[], perimetro='', id='fonti' }=Astro.props;
const testi=[Astro.props.testi??[]].flat();
const selezione=fontiPerPagina([...testi.flatMap(t=>t.fatti),...fatti],[...testi.flatMap(t=>t.fonti),...extra],tappe,await tutteLeFonti());
const fonti=registroFonti(selezione);
const gruppi=new Map([...Map.groupBy(ordinaFonti(fonti),s=>s.luoghi.length>1?'Fonti condivise':s.luoghi[0]||s.editore)].sort(([a],[b])=>a.localeCompare(b,'it')));
const segno=cautela||testi.some(t=>t.cautela);
const cerca=fonti.length>5;
---
{fonti.length>0 && <section class="fonti-pannello section" aria-labelledby={`${id}-h`}>
  <div class="wrap fonti variant-d">
    <h2 class="sr" id={`${id}-h`}>Fonti di questa pagina</h2>
    <div class="essential">
      {segno && <p id={id==='fonti'?'segno':`${id}-segno`}><strong>*</strong> Un asterisco segnala un’informazione da leggere con cautela. Il motivo è nella frase.</p>}
      {tappe.length>0 && <p>I tempi sono stime. Prima di prenotare o partire, controlla le informazioni del gestore per il giorno scelto.</p>}
    </div>
    <details class="disclosure" id={`${id}-inizio`}>
      <summary><span class="summary-title">Fonti di questa pagina</span><span class="count">{fonti.length} {fonti.length===1?'fonte':'fonti'}</span><span class="open-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></span></summary>
      <div class="body">
        {cerca && <><div class="search-tools" hidden><label for={`${id}-cerca`}>Cerca nelle fonti</label><input id={`${id}-cerca`} type="search" placeholder="Luogo, informazione o editore" autocomplete="off" spellcheck="false" aria-describedby={`${id}-stato`}/></div><div class="access-rail" data-long-list={fonti.length>50?true:undefined} hidden><p id={`${id}-stato`} class="search-status" role="status" aria-atomic="true">{fonti.length} fonti</p><button type="button" class="context-action" data-context-action hidden>Mostra tutte</button></div><p class="no-results" hidden>Nessuna fonte trovata. Prova un altro nome o usa «Mostra tutte».</p></>}
        {perimetro && <p class="scope">{perimetro}</p>}
        <div class="notebook" data-volume={fonti.length>50?'lungo':'breve'}>
          {[...gruppi].map(([nome,items])=><section class="group" aria-labelledby={`${id}-gruppo-${slugFonte(nome)}`}><div class="group-head"><h3 id={`${id}-gruppo-${slugFonte(nome)}`}>{nome}</h3>{items.length>1&&<span class="group-count" data-group-count>{items.length} fonti</span>}</div><ul class="source-list">{items.map(s=><Documento fonte={s} prefisso={`${id}-`} contesto={s.luoghi.length>1}/>)}</ul></section>)}
        </div>
        <div class="method"><a href="/fonti/">Come scegliamo e controlliamo le fonti <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a><p>Il controllo non indica la validità odierna. Per aprire i documenti esterni serve una connessione.</p><a class="back-top" href={`#${id}-inizio`}>Torna all’inizio delle fonti</a></div>
      </div>
    </details>
  </div>
</section>}
<script>import '../scripts/fonti/pannello';</script>
